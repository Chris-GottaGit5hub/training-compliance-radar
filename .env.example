# AI provider: google (default) | anthropic
AI_PROVIDER=
# Optional model override (defaults: gemini-3.8-flash / claude-haiku-5-5)
AI_MODEL=
# Optional backup model if the primary is overloaded (default gemini-3.6-flash for Gemini; "none" disables)
AI_FALLBACK_MODEL=
# Optional, Gemini only: minimal | low (default) | medium | high. Lower is faster.
AI_THINKING_LEVEL=
# Required when AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
# Required only when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
