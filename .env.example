# AI provider: google (default) | anthropic | groq
AI_PROVIDER=
# Optional model override (defaults: gemini-3.8-flash / claude-haiku-5-5 / openai/gpt-oss-120b)
AI_MODEL=
# Optional ordered backups, comma-separated "model" (same provider) or "provider:model".
# Defaults: gemini-3.6-flash (google); google:gemini-3.6-flash,google:gemini-3.8-flash (groq). "none" disables.
AI_FALLBACK_MODEL=
# Optional, Gemini only: minimal | low (default) | medium | high. Lower is faster.
AI_THINKING_LEVEL=
# Required when AI_PROVIDER=google, or for a google: backup
GOOGLE_GENERATIVE_AI_API_KEY=
# Required when AI_PROVIDER=groq, or for a groq: backup
GROQ_API_KEY=
# Required only when AI_PROVIDER=anthropic, or for an anthropic: backup
ANTHROPIC_API_KEY=
